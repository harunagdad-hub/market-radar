generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PriceSource {
  OFFICIAL
  USER
  IMPORT
}


model Province {
  id        Int        @id @default(autoincrement())
  code      Int        @unique
  name      String     @unique
  districts District[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model District {
  id            Int           @id @default(autoincrement())
  provinceId    Int
  name          String
  province      Province      @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  neighborhoods Neighborhood[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([provinceId, name])
  @@index([provinceId])
}

model Neighborhood {
  id          Int           @id @default(autoincrement())
  districtId  Int
  name        String
  district    District      @relation(fields: [districtId], references: [id], onDelete: Cascade)
  branches    MarketBranch[]
  addresses   Address[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([districtId, name])
  @@index([districtId])
}

model MarketChain {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  slug      String         @unique
  logoUrl   String?
  isActive  Boolean        @default(true)
  branches  MarketBranch[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model MarketBranch {
  id          Int         @id @default(autoincrement())
  chainId     Int
  name        String
  address     String
  city        String
  district       String?
  neighborhoodId Int?
  latitude       Float
  longitude      Float
  isActive       Boolean      @default(true)
  chain          MarketChain  @relation(fields: [chainId], references: [id], onDelete: Cascade)
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  prices         Price[]
  campaigns    Campaign[]
  priceReports PriceReport[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([chainId])
  @@index([city])
  @@index([neighborhoodId])
  @@index([latitude, longitude])
}

model Product {
  id          Int        @id @default(autoincrement())
  name        String
  barcode     String?    @unique
  brand       String?
  category    String?
  unit        String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  prices      Price[]
  campaigns   Campaign[]
  favorites   Favorite[]
  priceReports PriceReport[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([name])
  @@index([category])
}

model Price {
  id          Int         @id @default(autoincrement())
  productId   Int
  branchId    Int
  price       Decimal     @db.Decimal(10, 2)
  oldPrice    Decimal?    @db.Decimal(10, 2)
  source      PriceSource @default(IMPORT)
  validFrom   DateTime    @default(now())
  validUntil  DateTime?
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch      MarketBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([productId])
  @@index([branchId])
  @@index([productId, branchId])
}

model Campaign {
  id          Int          @id @default(autoincrement())
  productId   Int
  branchId    Int?
  title       String
  description String?
  discount    Decimal?     @db.Decimal(5, 2)
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean      @default(true)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch      MarketBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@index([productId])
  @@index([branchId])
  @@index([startDate, endDate])
}

model User {
  id        Int        @id @default(autoincrement())
  name      String?
  email     String     @unique
  password  String?
  addresses Address[]
  favorites Favorite[]
  reports   PriceReport[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Address {
  id             Int           @id @default(autoincrement())
  userId         Int
  title          String
  address        String
  city           String
  district       String?
  neighborhood   String?
  neighborhoodId Int?
  latitude       Float
  longitude      Float
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  location       Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([neighborhoodId])
}

model Favorite {
  id        Int         @id @default(autoincrement())
  userId    Int
  productId Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model PriceReport {
  id          Int         @id @default(autoincrement())
  userId      Int
  productId   Int
  branchId    Int
  reportedPrice Decimal   @db.Decimal(10, 2)
  note        String?
  status      String      @default("PENDING")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch      MarketBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([productId])
  @@index([branchId])
  @@index([status])
}
